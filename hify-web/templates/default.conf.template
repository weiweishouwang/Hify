server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ── 静态资源 ────────────────────────────────────────────────
    # 带 hash 的构建产物，可以放心长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 单页应用：任何未知路径都回 index.html，交给前端路由
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # ── 反代到 api ──────────────────────────────────────────────
    # 上游地址来自环境变量 API_UPSTREAM：
    #   Docker Compose 里是 api:8080（服务名）
    #   Kubernetes 里是 hify-api:8080（Service 名）
    # 同一份配置要能在两种拓扑下都跑起来，地址就不能写死。
    #
    # 生产用的是「方案 A」—— Ingress 把 /api 直接路由到 hify-api，
    # 请求根本走不到这一段（部署规格 §13.8）。保留它是为了：
    #   · 开发环境没有 Ingress，nginx 是唯一入口
    #   · 直连 web Service 时（比如排障）仍然能用
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ── SSE 必需的四项 ───────────────────────────────────
        # 1. 不缓冲：否则 nginx 会攒完整个响应才发给客户端，流式变成非流式
        proxy_buffering off;
        # 2. 不缓存：同上
        proxy_cache off;
        # 3. 超时放宽：默认 60s 会掐断超过 1 分钟的生成
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # 4. 分块传输：SSE 靠它逐帧下发
        chunked_transfer_encoding on;
    }
}
