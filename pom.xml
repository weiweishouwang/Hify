<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.hify</groupId>
  <artifactId>hify-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>hify-parent</name>
  <description>Hify —— 可本地部署的 AI Agent 开发平台（模块化单体）</description>

  <modules>
    <module>hify-shared</module>
    <module>hify-ai</module>
    <module>hify-tool</module>
    <module>hify-knowledge</module>
    <module>hify-mcp</module>
    <module>hify-agent</module>
    <module>hify-conversation</module>
    <module>hify-workflow</module>
    <module>hify-demo</module>
    <module>hify-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.5.16</spring-boot.version>
    <mybatis-plus.version>3.5.18</mybatis-plus.version>
    <mcp-sdk.version>2.1.0</mcp-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot 全家桶版本 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        内部模块统一在这里声明版本，子模块引用时不写 <version>。
        依赖方向必须与 CLAUDE.md §2.1 一致，且保持无环（enforcer 的 banCircularDependencies 会拦截）。
      -->
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-conversation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-workflow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hify</groupId>
        <artifactId>hify-demo</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 第三方 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp</artifactId>
        <version>${mcp-sdk.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    所有模块共用的基础设施依赖。

    理由：模块化单体，9 个模块最终进同一个 Spring 上下文与同一个应用进程。共用依赖集中在这里，
    避免 9 份重复声明导致版本或作用域漂移。模块之间的差异只体现在「内部模块依赖」上。
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      WebClient + Reactor Netty：LLM/MCP 调用与 SSE 写出。
      只引 spring-webflux 而非 spring-boot-starter-webflux，避免引入 Reactive Web 栈的自动配置；
      应用仍以 Servlet 模式启动（Spring Boot 在 webmvc 在场时优先判定为 SERVLET）。
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>io.projectreactor.netty</groupId>
      <artifactId>reactor-netty-http</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- @Transactional 基于 AOP 代理，需要 AspectJ 支持 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- Spring Cache：@EnableCaching 的基础设施（spring-context-support 等） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>

    <!-- JdbcTemplate：PG 向量库侧手写 SQL（pgvector 的 <=> 运算符与 HNSW 查询，MP 生成不了） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>

    <!-- 分页拦截器：MyBatis-Plus 3.5.18 把 PaginationInnerInterceptor 拆到这个模块
         （它依赖 JSqlParser 来拼分页 SQL 与 count 语句），starter 不再传递引入。 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
    </dependency>

    <!-- Redis：缓存、限流计数、分布式锁、幂等键。必须在 Redis，不能用本地缓存（多副本会不一致） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 与 Spring Boot 3.5.16 BOM 一致的插件版本，避免用 Maven 3.8.7 默认绑定的 2.x 老插件 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        依赖图必须无环。

        规则来源：banCircularDependencies 不在 enforcer 自带的 enforcer-rules 里，
        需显式引入 org.codehaus.mojo:extra-enforcer-rules 才会被加载。

        绑定到 verify 而非 validate：这条规则需要解析完整依赖图才能判定，
        而 validate 阶段内部模块（SNAPSHOT）尚未构建、无法被解析，会误报
        "Could not find artifact com.hify:hify-shared:jar:0.1.0-SNAPSHOT"。
        verify 阶段 reactor 内的模块已完成打包，可正常解析。

        补充：模块之间的环（reactor 级）Maven 在构建 reactor 时就会直接报
        "The projects in the reactor contain a cyclic reference"，无需依赖本规则；
        本规则覆盖的是解析后完整依赖图里涉及第三方 artifact 的环。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>extra-enforcer-rules</artifactId>
            <version>1.12.1</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>ban-circular-dependencies</id>
            <phase>verify</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <banCircularDependencies/>
                <requireMavenVersion><version>[3.6.1,)</version></requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
