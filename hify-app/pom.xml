<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.hify</groupId>
    <artifactId>hify-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hify-app</artifactId>
  <packaging>jar</packaging>

  <name>hify-app</name>
  <description>启动、装配、静态资源与反代配置。唯一可执行模块</description>

  <dependencies>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-ai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-knowledge</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-mcp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-agent</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-conversation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-workflow</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        只有本模块 repackage 成可执行 jar；其余 8 个模块是普通 jar。
        启动类：com.hify.app.HifyApplication
        装配方式：@SpringBootApplication(scanBasePackages = "com.hify")，扫描全部模块的组件。
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.hify.app.HifyApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
