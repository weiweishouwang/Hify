  <dependencies>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-ai</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-knowledge</artifactId>
    </dependency>
    <!-- agent 节点：复用已配置好的 Agent，不重复实现推理逻辑 -->
    <dependency>
      <groupId>com.hify</groupId>
      <artifactId>hify-agent</artifactId>
    </dependency>
  </dependencies>

  <!--
    不变量：本模块与 hify-conversation 互不依赖（两者是平行的编排层）。
  -->
</project>
