# 本地开发环境的账号密码覆盖项（复制为 .env 后按需修改）
#
# docker-compose.yml 里全部用 ${VAR:-默认值} 的形式，不设任何变量时用弱口令直接跑起来。
# 生产环境不要用这套口令。

HIFY_DB_ROOT_PASSWORD=hify-root
HIFY_DB_NAME=hify
HIFY_DB_USERNAME=hify
HIFY_DB_PASSWORD=hify
# 本机标准端口被现有容器栈占用，这里用空闲端口
HIFY_DB_PORT=3308

HIFY_PG_NAME=hify
HIFY_PG_USERNAME=hify
HIFY_PG_PASSWORD=hify
HIFY_PG_PORT=5433

HIFY_REDIS_PORT=6380

HIFY_API_PORT=8082
HIFY_WEB_PORT=8083

# 工具请求头等凭据的 AES-GCM 加密密钥：Base64 编码的 32 字节。
# 生成：openssl rand -base64 32
# 不配置时创建带凭据的工具会被拒绝写入（不降级成明文）。
HIFY_TOOL_ENCRYPTION_KEY=
